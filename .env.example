# Server-side only. Set these in Vercel -> Project Settings -> Environment Variables.
# Never prefix with VITE_ (that would ship the key to every browser).
GEMINI_API_KEY=
# Optional. Defaults to gemini-3.8-flash (listed as stable on ai.google.dev/gemini-api/docs/models, checked 25 Oct 2026).
GEMINI_MODEL=
